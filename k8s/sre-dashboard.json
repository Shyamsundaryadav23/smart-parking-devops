{
  "title": "Smart Parking - SRE SLO Dashboard",
  "uid": "smart-parking-sre",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "smart_parking:availability * 100",
          "legendFormat": "Availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP Error Rate",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "smart_parking:error_rate * 100",
          "legendFormat": "Error Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95 Latency",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "smart_parking:p95_latency_seconds * 1000",
          "legendFormat": "P95 Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Availability SLI",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "smart_parking:availability * 100",
          "legendFormat": "Availability %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 95,
          "max": 100
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Error Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "smart_parking:error_rate * 100",
          "legendFormat": "Error Rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "P95 Latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "smart_parking:p95_latency_seconds * 1000",
          "legendFormat": "P95 Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Availability SLO Target",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "expr": "99",
          "legendFormat": "Target"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Error Rate SLO Target",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "expr": "1",
          "legendFormat": "Target"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Latency SLO Target",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 21
      },
      "targets": [
        {
          "expr": "500",
          "legendFormat": "Target"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Overall SLO Status",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "targets": [
        {
          "expr": "(\n  (smart_parking:availability >= 0.99)\n  and\n  (smart_parking:error_rate < 0.01)\n  and\n  (smart_parking:p95_latency_seconds < 0.5)\n) * 1",
          "legendFormat": "SLO Status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "VIOLATED"
                },
                "1": {
                  "text": "HEALTHY"
                }
              }
            }
          ]
        }
      }
    }
  ]
}